# Скопируйте в panel.env и подставьте значения:
#   docker compose --env-file panel.env up -d

GITHUB_OWNER=your-org
GITHUB_REPO=your-repo
GITHUB_TOKEN=
BRANCH_PREFIX=release/2

# Swagger UI в Production/Docker: EnableSwagger=true (в корневом appsettings или переменная окружения)
# ENABLE_SWAGGER=true
