{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": false,
  "GITHUB_OWNER": "",
  "GITHUB_REPO": "",
  "GITHUB_TOKEN": "",
  "COMPOSE_DIR": "/opt/vneocheredi",
  "ENV_FILE": "/opt/vneocheredi/.env",
  "IMAGE_ENV_KEY": "IMAGE_TAG",
  "BRANCH_PREFIX": "release/2",
  "ServiceLinkEnvKeys": {
    "Admin": "DNS_NAME_BACKOFFICE",
    "Server": "DNS_NAME_SERVER",
    "Portal": "DNS_NAME_RDV",
    "Call": "DNS_NAME_CALL"
  },
  "PortAllocation": {
    "ScanMin": 1024,
    "ScanMax": 65535,
    "Keys": [
      "RABBITMQ_PORT_1",
      "RABBITMQ_PORT_2",
      "POSTGRES_PORT",
      "MASTER_POSTGRES_PORT",
      "FILE_STORAGE_PORT",
      "SPEECH_PORT",
      "CALL_PORT",
      "PORTAL_PORT",
      "ADMIN_PORT",
      "SERVER_PORT",
      "TELEMETRY_COLLECTOR_PORT_1",
      "TELEMETRY_COLLECTOR_PORT_2"
    ]
  }
}
