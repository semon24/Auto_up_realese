// Пример файла пароля агента (путь задаётся в AGENT_PASSWORD_JSON_PATH).
// При первом запуске AgentPasswordBootstrap может создать файл с одним полем password,
// если файла ещё нет — см. AgentPasswordBootstrap.WritePassword().
//
// API при POST /api/agents/{host}/password отправляет пароль по SignalR; агент сравнивает
// введённое значение с полем "password" здесь (UTF-8, сравнение по байтам).
//
// Скопируйте как шаблон, задайте AGENT_PASSWORD_JSON_PATH на абсолютный путь к реальному .json
// (расширение .json, не .jsonc — стандартный JsonSerializer читает обычный JSON).

{
  "password": "ЗАМЕНИТЕ_НА_СЕКРЕТ_ИЛИ_ОСТАВЬТЕ_СГЕНЕРИРОВАННЫЙ"
}
